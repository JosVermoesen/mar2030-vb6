Private Sub DataEnvironment_Initialize()

    deMarNet.cnnMarJet.ConnectiéonString = _
        "Provider=Microsoft.Jet.OLEDB.4.0;" & _
        "Data Source=" & BedrijfsLokatie & "marnt.mdv;" & _
        "Persist Security Info=False"
    SnelHelpPrint "Dataomgeving wordt geïnitialiseerd...", blLogging
    
    deMarNet.cnnMarSQL.ConnectionString = _
        "Provider=SQLOLEDB.1;" & _
        "Persist Security Info=False;" & _
        "User ID=sa;" & _
        "Initial Catalog=marXP001"

    SnelHelpPrint "Dataomgeving wordt geïnitialiseerd...", blLogging
    
End Sub

Private Sub DataEnvironment_Terminate()

    SnelHelpPrint "Dataomgeving wordt beëindigd...", blLogging

End Sub

