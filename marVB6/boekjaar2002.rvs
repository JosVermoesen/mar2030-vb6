 c_rgszSh[5] = "Belstar";
 c_rgszSh[6] = "Das";
 c_rgszSh[7] = "deltalloyd";
 c_rgszSh[8] = "D.K.V.";
 c_rgszSh[9] = "Eural";
 c_rgszSh[10] = "Euromex";
 c_rgszSh[11] = "Europ Assistance";
 c_rgszSh[12] = "Fidea '99";
 c_rgszSh[13] = "Fortis AG";
 c_rgszSh[14] = "Generali Belgium";
 c_rgszSh[15] = "Generali Lux.";
 c_rgszSh[16] = "ING Insurance";
