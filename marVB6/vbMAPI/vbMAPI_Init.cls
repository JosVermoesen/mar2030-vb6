Function NewSession() As vbMAPI_Session
    Set NewSession = m_ClassFactory.NewSession()
End Function

Function NewOutlookWrapper(ByVal OutlookObject As Object, Optional ByVal NoSave As Boolean) As vbMAPI_MailItem
    Set NewOutlookWrapper = m_ClassFactory.NewOutlookWrapper(OutlookObject, NoSave)
End Function


